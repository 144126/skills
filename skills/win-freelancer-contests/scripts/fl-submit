#!/bin/bash
# fl-submit <contest_id> <title> <desc|@file> <image>... — one contest entry per image
set -u
T="${FREELANCER_TOKEN:?set FREELANCER_TOKEN}"
cid="$1"; title="$2"; desc="$3"; shift 3
[ $# -ge 1 ] || { echo "usage: fl-submit <contest_id> <title> <desc|@file> <image>..."; exit 1; }
[[ "$desc" == @* ]] && desc="$(cat "${desc#@}")"
[ "${#title}" -le 50 ] || echo "warn: title ${#title} chars (limit 50)"
[ "${#desc}" -le 1000 ] || echo "warn: desc ${#desc} chars (limit 1000)"
for f in "$@"; do
  [ -f "$f" ] || { echo "no file: $f"; exit 1; }
  for try in 1 2 3 4; do
    r=$(curl -s -m 120 -X POST "https://www.freelancer.com/api/contests/0.1/entries/" \
      -H "freelancer-oauth-v1: $T" \
      -F "contest_id=$cid" -F "title=$title" -F "description=$desc" -F "entry_file=@$f")
    if [[ "$r" == *NOT_AUTHENTICATED* ]]; then echo "rate-limited, waiting 20s ($try)"; sleep 20; continue; fi
    break
  done
  echo "$f -> $(echo "$r" | python3 -c "import sys,json;d=json.load(sys.stdin);e=d.get('result',{}).get('entry',{});print('entry',e.get('number'),e.get('status') if d.get('status')=='success' else d.get('message'))")"
  sleep 2
done
